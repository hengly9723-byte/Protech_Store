{
  "name": "protech-store",
  "main": "Frontend/worker/index.js",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./Frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "protech-store-db"
    }
  ]
}
